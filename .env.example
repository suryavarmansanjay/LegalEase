# Copy this file to .env for local development.
# Never commit a real API key to GitHub.

GEMINI_API_KEY=your_gemini_api_key_here

# Use a currently supported Gemini model for your API account.
# The application defaults to gemini-2.5-flash if this is omitted.
GEMINI_MODEL=gemini-2.5-flash

# Local development:
BACKEND_URL=http://127.0.0.1:8000

# For deployment, set BACKEND_URL to your deployed FastAPI URL.
